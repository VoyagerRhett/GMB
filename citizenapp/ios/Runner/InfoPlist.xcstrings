            "value": "公民"
          }
        }
      }
    },
    "CFBundleName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CitizenApp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公民"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CitizenApp uses the camera to scan QR codes and capture photos and videos in chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公民 需要使用摄像头扫描二维码，以及在聊天中拍摄照片和视频。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CitizenApp uses Face ID to confirm reading your wallet private key from this device's secure vault."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公民 使用 Face ID 确认读取本设备安全金库中的钱包私钥。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CitizenApp uses the microphone to record voice messages and audio for chat videos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公民 需要使用麦克风录制聊天语音和视频声音。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CitizenApp saves QR codes and avatars to your photo library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公民 需要保存二维码或头像到相册。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CitizenApp accesses your photo library for profile pictures, chat photos or videos, and media published with content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公民 需要访问相册以设置头像、在聊天中选择照片或视频，以及为内容选择发布媒体。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
