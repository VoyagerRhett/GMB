{
  "name": "citizenweb",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "25.2.1"
  },
  "scripts": {
    "dev": "vite --config scripts/vite.config.ts",
    "build": "tsc -b scripts/tsconfig.json && vite build --config scripts/vite.config.ts",
