/target/
**/target/
/build/
/.dart_tool/
/.packages
/.flutter-plugins
/.flutter-plugins-dependencies
/coverage/
/darwin/.build/
/darwin/.swiftpm/
/darwin/Pods/
/darwin/DerivedData/
# Linux运行库只允许由Release候选从产品源码外产物目录注入；
# 源码树永远不能保存 Core/Host ELF、CMake cache 或安装投影。
/linux/lib/
/linux/.cache/
/linux/CMakeCache.txt
/linux/CMakeFiles/
/linux/cmake_install.cmake
# Windows 运行件只在中央候选中注入；源码树不得保存 DLL/LIB/CMake/MSVC 状态。
/windows/bin/
/windows/lib/
/windows/.vs/
/windows/CMakeCache.txt
/windows/CMakeFiles/
/windows/cmake_install.cmake
/windows/**/*.dll
/windows/**/*.lib
/windows/**/*.obj
/windows/**/*.pdb
*.xcresult
*.dSYM
*.log
*.tmp
*.swp
.DS_Store
